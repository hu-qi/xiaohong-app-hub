declare_args() {
  fan_gpio_pin = 9     # 风扇控制 GPIO 编号
  fan_gpio_mode = 0
  fan_button_pin = 5   # 按键 GPIO 编号
  fan_button_mode = 4
}

static_library("smart_fan_demo") {
  sources = [ "fan_demo.c" ]

  defines = [
    "FAN_GPIO_PIN=$fan_gpio_pin",
    "FAN_GPIO_MODE=$fan_gpio_mode",
    "FAN_BUTTON_PIN=$fan_button_pin",
    "FAN_BUTTON_MODE=$fan_button_mode",
  ]

  include_dirs = [
    "//device/soc/hisilicon/ws63v100/sdkv106/include",
    "//device/soc/hisilicon/ws63v100/sdkv106/include/driver",
    "//device/soc/hisilicon/ws63v100/sdkv106/drivers/drivers/hal/gpio",
    "//device/soc/hisilicon/ws63v100/sdkv106/drivers/drivers/hal/gpio/v150",
    "//device/soc/hisilicon/ws63v100/sdkv106/drivers/chips/ws63/porting/pinctrl",
    "//device/soc/hisilicon/ws63v100/sdkv106/drivers/chips/ws63/porting/gpio",
    "//device/soc/hisilicon/ws63v100/sdkv106/kernel/osal/include",
    "//device/soc/hisilicon/ws63v100/sdkv106/kernel/osal/include/interrupt",
    "//device/soc/hisilicon/ws63v100/sdkv106/kernel/osal/include/debug",
    "//device/soc/hisilicon/ws63v100/sdkv106/kernel/osal/include/schedule",
    "//device/soc/hisilicon/ws63v100/sdkv106/middleware/utils/app_init",
    "//kernel/liteos_m/components/cmsis/2.0",
  ]
}
