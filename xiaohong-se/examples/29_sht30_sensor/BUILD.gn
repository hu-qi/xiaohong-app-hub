sht30_i2c_bus = 1
sht30_i2c_scl_pin = 16
sht30_i2c_sda_pin = 15
sht30_i2c_pin_mode = 2
sht30_i2c_baud = 400000
sht30_addr_7b = 68

static_library("sht30_sensor_demo") {
  sources = [
    "sht30_sensor_demo.c",
    "sht30.c",
  ]

  defines = [
    "CONFIG_I2C_MASTER_BUS_ID=$sht30_i2c_bus",
    "CONFIG_I2C_SCL_MASTER_PIN=$sht30_i2c_scl_pin",
    "CONFIG_I2C_SDA_MASTER_PIN=$sht30_i2c_sda_pin",
    "CONFIG_I2C_MASTER_PIN_MODE=$sht30_i2c_pin_mode",
    "I2C_SET_BANDRATE=$sht30_i2c_baud",
    "CONFIG_SHT30_I2C_ADDR_7B=$sht30_addr_7b",
  ]

  include_dirs = [
    ".",
    "//base/startup/init/interfaces/innerkits/include",
    "//device/soc/hisilicon/ws63v100/sdkv106/kernel/osal/include",
    "//device/soc/hisilicon/ws63v100/sdkv106/kernel/osal/include/debug",
    "//device/soc/hisilicon/ws63v100/sdkv106/kernel/osal/include/schedule",
    "//device/soc/hisilicon/ws63v100/sdkv106/include/driver",
    "//device/soc/hisilicon/ws63v100/sdkv106/drivers/chips/ws63/porting/pinctrl",
    "//device/soc/hisilicon/ws63v100/sdkv106/drivers/chips/ws63/porting/i2c",
    "//device/soc/hisilicon/ws63v100/sdkv106/drivers/drivers/hal/i2c",
  ]
}
