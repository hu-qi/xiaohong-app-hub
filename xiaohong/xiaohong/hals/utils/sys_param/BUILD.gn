import("//vendor/atomgit/xiaohong/ws63_sdk.gni")

static_library("hal_sysparam") {
  sources = [ "hal_sys_param.c" ]
  include_dirs = [
    "//base/startup/init/interfaces/hals",
    "${ws63_sdk_path}/include/driver",

    "${ws63_sdk_path}/kernel/osal/include",
    "${ws63_sdk_path}/include/driver",
    "${ws63_sdk_path}/drivers/drivers/hal/gpio",
    "${ws63_sdk_path}/drivers/drivers/hal/gpio/v150",
    "${ws63_sdk_path}/drivers/chips/ws63/porting/pinctrl",
    "${ws63_sdk_path}/drivers/chips/ws63/porting/gpio",
    "${ws63_sdk_path}/drivers/drivers/hal/spi",
    "${ws63_sdk_path}/drivers/drivers/hal/spi/v151",
    "${ws63_sdk_path}/drivers/chips/ws63/porting/spi",
    "${ws63_sdk_path}/drivers/chips/ws63/porting/dma",
    "${ws63_sdk_path}/drivers/drivers/hal/uart",
    "${ws63_sdk_path}/drivers/chips/ws63/porting/uart",
    "${ws63_sdk_path}/middleware/utils/common_headers/native",
  ]
  defines = [
    "INCREMENTAL_VERSION=\"${ohos_version}\"",
    "BUILD_TYPE=\"${ohos_build_type}\"",
    "BUILD_USER=\"${ohos_build_user}\"",
    "BUILD_TIME=\"${ohos_build_time}\"",
    "BUILD_HOST=\"${ohos_build_host}\"",
    "BUILD_ROOTHASH=\"${ohos_build_roothash}\"",
  ]
}
