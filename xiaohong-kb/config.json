{
  "product_name": "xiaohong-kb",
  "type": "mini",
  "version": "3.0",
  "ohos_version": "OpenHarmony 1.0",
  "device_company": "atomgit",
  "device_build_path": "device/board/atomgit/xiaohong",
  "board": "xiaohong",
  "kernel_type": "liteos_m",
  "kernel_is_prebuilt": true,
  "kernel_version": "",
  "third_party_dir": "//device/soc/hisilicon/ws63v100/sdkv106/open_source",
  "product_adapter_dir": "//vendor/atomgit/xiaohong-kb/hals",
  "subsystems": [
    {
      "subsystem": "iothardware",
      "components": [
        { "component": "peripheral", "features":[] }
      ]
    },
    {
      "subsystem": "hiviewdfx",
      "components": [
        { "component": "hilog_lite", "features":["hilog_lite_mini = true"] },
        { "component": "hievent_lite", "features":["hievent_lite_mini = true"] }
      ]
    },
    {
      "subsystem": "systemabilitymgr",
      "components": [
        { "component": "samgr_lite", "features":
        [
          "enable_ohos_systemabilitymgr_samgr_lite_broadcast = false",
          "enable_ohos_systemabilitymgr_samgr_lite_system_capability = false",
          "config_ohos_systemabilitymgr_samgr_lite_shared_task_size = 2048",
          "enable_ohos_systemabilitymgr_samgr_lite_specified_task = false",
          "enable_ohos_systemabilitymgr_samgr_lite_no_task = false"
        ]
        }
      ]
    },
    {
      "subsystem": "security",
      "components": [
        { "component": "huks", "features":
        [
          "huks_use_lite_storage = true",
          "huks_use_hardware_root_key = true",
          "huks_config_file = \"hks_config_lite.h\""
        ]
        }
      ]
    },
    {
      "subsystem": "startup",
      "components": [
        { "component": "bootstrap_lite", "features":
        [
          "bootstrap_lite_enable_bootstrap_service = false"
        ]
        },
        { "component": "init", "features":
        [
          "init_feature_begetctl_liteos = true",
          "init_lite_use_thirdparty_mbedtls = true"
        ]
        }
      ]
    },
    {
      "subsystem": "updater",
      "components": [
        { "component": "sys_installer_lite", "features":[] }
      ]
    },
    {
      "subsystem": "commonlibrary",
      "components": [
        { "component": "utils_lite", "features":[ "utils_lite_feature_file = true" ] }
      ]
    },
    {
      "subsystem": "developtools",
      "components": [
        { "component": "syscap_codec", "features":[] }
      ]
    }
  ]
}
