import("//vendor/atomgit/xiaohong-kb/ws63_sdk.gni")
import("config.gni")

static_library("xiaohong") {
  # main task entry and common APIs
  sources = [
    "src/main.c",
    "src/task_entry.c",
    "src/settings.c",
    "src/kb_keymap.c",
    "src/kb_key_dispatch.c",
  ]

  defines = [
    "FW_VERSION=0x030000",    # 固件版本：0x010203 = 1.2.3
  ]
  if (config_ohos_enable) {
    defines += [
      "SUPPORT_OHOS=1",         # [1]with ohos fwk [0]only fbb-ws63 SDK, no ohos fwk
    ]
  }
  include_dirs = [
    "src",
    "src/boards",
  ]

  # external log
  if (config_log_enable) {
    defines += [ "DEFAULT_LOG_LEVEL=LOG_INFO" ]
    sources += [
      "src/log/log.c",
    ]
    include_dirs += [
      "src/log",
    ]
  }

  # hw and board config, low level APIs
  if (config_board_name == "xiaohong_ws63_kb") {
    defines += [
      "BOARD_XH_WS63_KB",
      "LED_DIMMING_ENABLE=1",
    ]
    sources += [
      "src/boards/xiaohong_ws63_kb/board_config.c",
      "src/boards/xiaohong_ws63_kb/key_config.c",
      "src/boards/xiaohong_ws63_kb/led_config.c",
    ]
    include_dirs += [
      "src/boards/xiaohong_ws63_kb",
    ]
  }

  if (config_sle_enable) {
    defines += [
      "SUPPORT_SLE_KEYBOARD",
      "SLE_SERVER_NAME=\"sle_kb_usb_dongle\"",  # 键盘(Sle Client)默认搜索并连接的Dongle(Sle Server)名称
      "SLE_1_CLIENT_M_SERVER=1",                # 1个键盘(1 Sle Client) 最多连接1个Dongle(1 Sle Server)
      "USE_CUSTOM_MAC_ADDR=0",                  # 1-用户自定义Client/Server的Mac地址, 0-使用随机生成的Client/Server的Mac地址
      "USE_OHOS_API=1",                         # 1-使用OHOS封装的SLE API, 0-使用海思WS63 SDK原生的SLE API;
                                                # 注意: config_ohos_enable[0] 时，仅支持"USE_OHOS_API=0";
                                                #       config_ohos_enable[1] 时，支持"USE_OHOS_API=0"和"USE_OHOS_API=1";
    ]
    sources += [
      "src/sle_client_kb/sle_client.c",
      "src/sle_client_kb/sle_client_kb.c",
    # for "USE_OHOS_API=1"
      "src/sle_client_kb/sle_shim_weak.c",
    ]
    include_dirs += [
      "src/sle_client_kb",
      "${ws63_sdk_path}/../adapter/hals/communication/sle_lite/include",
      "${ws63_sdk_path}/include/middleware/services/bts/sle",

    # for "USE_OHOS_API=1"
      "//device/soc/hisilicon/ws63v100/adapter/hals/communication/sle_lite/include",
    ]
  }

  # ble hid keyboard: 小鸿键盘发射端作为 BLE 外设(Peripheral), 广播HID服务,
  # PC(蓝牙Central)可直接扫描到并连接, 当普通蓝牙键盘收发按键
  if (config_ble_enable) {
    defines += [
      "SUPPORT_BLE_KEYBOARD",
      "BLE_HID_DEV_NAME=\"AtomGit-KB\"",
    ]
    sources += [
      "src/ble_client_kb/ble_client.c",
      "src/ble_client_kb/ble_client_kb.c",
    ]
    include_dirs += [
      "src/ble_client_kb",
      "${ws63_sdk_path}/include/middleware/services/bts/common",
      "${ws63_sdk_path}/include/middleware/services/bts/ble",
    ]
  }

  # oled display hw and driver
  if (config_lcd_panel == "lcd_ST7789_240x240") {
    defines += [ "LCD_ST7789_240x240" ]
    sources += [
      "src/display/lcd_st7789/lcd_st7789_driver.c",
    ]
    include_dirs += [
      "src/display",
      "src/display/lcd_st7789",
    ]
  }

  # lvgl for display
  if (config_lvgl_enable) {
    defines += [
      "SUPPORT_LVGL",
    ]
    sources += [
      "src/display/disp_driver.c",
      "src/display/lvgl_task.c",
      "src/display/lvgl_ui_layout.c",

      "src/display/lvgl_ui_layout_main_page.c",

      "src/display/lvgl_ui_layout_local_page.c",
      "src/display/lvgl_ui_layout_settings_page.c",
      "src/display/lvgl_ui_layout_wifi_page.c",
      "src/display/lvgl_ui_layout_key_remap_page.c",

      "src/display/lvgl_ui_layout_normal_page.c",
      "src/display/lvgl_ui_layout_sle_pairing_page.c",

      "src/display/lvgl/lv_font_FontAwesom5_18.c",
      "src/display/lvgl/lv_font_SourceHanSerifCN_SemiBold_18_Default.c",
      "src/display/lvgl/lv_font_SourceHanSerifCN_SemiBold_22_Default.c",
    ]
    include_dirs += [
      "src/display/lvgl",
      "${ws63_sdk_path}/open_source/lvgl",
    ]
  }

  # network: 键盘配置模式（AP热点 + HTTP配置服务器），用于浏览器自定义键位映射
  if (config_network_enable) {
    defines += [ "SUPPORT_NETWORK" ]
    sources += [
      "src/network/net_wifi_hotspot.c",
      "src/network/net_kb_config_server.c",
    ]
    include_dirs += [
      "src/network",
    ]
  }

  if (config_ohos_enable) {
    include_dirs += [
      "//utils/native/lite/include",
      "//kernel/liteos_m/kal",
      "//base/startup/init/interfaces/innerkits/include/syspara",
    ]
  }

  include_dirs += [
    "${ws63_sdk_path}/include/driver",
    "${ws63_sdk_path}/drivers/drivers/hal/reboot",
    "${ws63_sdk_path}/drivers/drivers/hal/gpio",
    "${ws63_sdk_path}/drivers/drivers/hal/gpio/v150",
    "${ws63_sdk_path}/drivers/chips/ws63/porting/pinctrl",
    "${ws63_sdk_path}/drivers/chips/ws63/porting/gpio",
    "${ws63_sdk_path}/drivers/chips/ws63/porting/adc",

    "${ws63_sdk_path}/kernel/liteos/liteos_v208.5.0/Huawei_LiteOS/compat/linux/include",
    "${ws63_sdk_path}/kernel/osal/include",
    "${ws63_sdk_path}/kernel/osal/include/debug",
    "${ws63_sdk_path}/kernel/osal/include/memory",
    "${ws63_sdk_path}/kernel/osal/include/msgqueue",
    "${ws63_sdk_path}/kernel/osal/include/schedule",
    "${ws63_sdk_path}/kernel/osal/include/interrupt",

    "${ws63_sdk_path}/drivers/drivers/hal/spi",
    "${ws63_sdk_path}/drivers/drivers/hal/spi/v151",
    "${ws63_sdk_path}/drivers/chips/ws63/porting/spi",

    "${ws63_sdk_path}/drivers/drivers/hal/uart",
    "${ws63_sdk_path}/drivers/chips/ws63/porting/uart",

    "${ws63_sdk_path}/drivers/drivers/hal/timer",
    "${ws63_sdk_path}/drivers/chips/ws63/porting/timer",

    "${ws63_sdk_path}/drivers/chips/ws63/porting/dma",

    "${ws63_sdk_path}/include/middleware/utils",
    "${ws63_sdk_path}/include/middleware/services/wifi",
    "${ws63_sdk_path}/open_source/lwip/lwip_v2.1.3/src/include",
    "${ws63_sdk_path}/open_source/lwip/lwip_adapter/liteos_207/src/include",
    "${ws63_sdk_path}/open_source/littlefs/v2.5.0",
    "${ws63_sdk_path}/middleware/utils/common_headers/native",
    "${ws63_sdk_path}/middleware/chips/ws63/nv/nv_config/include",
    "${ws63_sdk_path}/middleware/utils/dfx/dfx_reboot/cpu_utils/public",
    "${ws63_sdk_path}/middleware/utils/dfx/dfx_reboot/reboot/shared",
  ]
}
