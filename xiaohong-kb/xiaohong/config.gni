declare_args() {
  config_ohos_enable = true
  config_board_name  = "xiaohong_ws63_kb"
  config_log_enable  = true
  config_sle_enable  = true   # SLE-HID: 键盘作为SLE外设, 需要通过SLE-Dongle与PC桥接使用
  config_ble_enable  = false  # BLE-HID: 键盘作为BLE外设, 直接被PC(蓝牙Central)扫描、连接和使用
                              # 功能尚未完全稳定，仅供感兴趣的开发者试用、完善、改进，欢迎提交PR
  config_lcd_panel   = "lcd_ST7789_240x240"  # "lcd_ST7735R_128x128" or else
  config_lvgl_enable = true

  config_network_enable = true
}